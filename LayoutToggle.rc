#include <winver.h>

#define VER_MAJOR 1
#define VER_MINOR 0
#define VER_PATCH 0
#define VER_BUILD 0
#define VER_STR "1.0.0.0"

#define IDI_APP 1

IDI_APP ICON "LayoutToggle.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, VER_BUILD
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Layout Toggle - Alt+Shift keyboard layout switcher"
            VALUE "FileVersion", VER_STR
            VALUE "InternalName", "LayoutToggle"
            VALUE "OriginalFilename", "LayoutToggle.exe"
            VALUE "ProductName", "Layout Toggle"
            VALUE "ProductVersion", VER_STR
            VALUE "LegalCopyright", "MIT License"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
